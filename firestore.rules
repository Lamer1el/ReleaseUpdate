rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Private user profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Public user profiles: Anyone can read, only owner can write their own profile
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'nickname'])
        && request.resource.data.uid == userId
        && request.resource.data.nickname.size() >= 3
        && request.resource.data.nickname.size() <= 20;
      allow delete: if false;
    }

    // Nickname reservations for uniqueness
    match /nicknameReservations/{normalizedNickname} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Benchmark runs: Authenticated users can submit their own runs
    match /benchmarkRuns/{runId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.methodologyVersion == 'Skitefi-v1.0'
        && request.resource.data.serverVerified == false;
      allow update, delete: if false; // Immutable audit log
    }

    // Global Leaderboard entries: Read public, creation only via authenticated user or cloud function
    match /leaderboardEntries/{entryId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.methodologyVersion == 'Skitefi-v1.0'
        && request.resource.data.verified == false;
      allow update, delete: if false;
    }

    // App server configuration (read-only for clients)
    match /appConfiguration/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
